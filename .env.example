# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://botbuilder:STRONG_PASSWORD@db:5432/botbuilder
DB_NAME=botbuilder
DB_USER=botbuilder
DB_PASSWORD=STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GENERATE_64_CHAR_RANDOM_STRING_HERE
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=30

# ── Encryption ────────────────────────────────────────────────────────────────
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=GENERATE_FERNET_KEY_HERE
BOT_TOKEN_ENCRYPTION_KEY=GENERATE_FERNET_KEY_HERE

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=https://yoqutdigital.uz
CORS_ORIGINS=https://yoqutdigital.uz

# ── Manager Bot (ixtiyoriy) ───────────────────────────────────────────────────
MANAGER_BOT_TOKEN=
MANAGER_BOT_USERNAME=

# ── OpenAI (ixtiyoriy) ────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Debug (production da false bo'lsin) ───────────────────────────────────────
DEBUG=false
